# Database
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/database"

# JWT Secret
JWT_SECRET="your_jwt_secret_here"

# Server
PORT=5000
NODE_ENV="development"

# Brevo (Email Service)
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="your_email@example.com"
BREVO_SENDER_NAME="Lotus Business"

# ImageKit (Image Storage)
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_URL_ENDPOINT="your_imagekit_url_endpoint"

# Debug
DEBUG_ADMIN=0
DEBUG_MAIL=0

# AI Services
MISTRAL_API_KEY="your_mistral_api_key"
GROQ_API_KEY="your_groq_api_key"

# Supabase Storage (pour les backups)
SUPABASE_URL="your_supabase_url"
SUPABASE_SERVICE_KEY="your_supabase_service_key"

# KKiaPay (pour les paiements mobiles)
KKIAPAY_PUBLIC_KEY="your_public_key_here"
KKIAPAY_PRIVATE_KEY="your_private_key_here"
KKIAPAY_SECRET="your_secret_here"
KKIAPAY_SANDBOX="true"
