generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LicenseType {
  FREE
  PREMIUM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum SubscriptionType {
  MONTHLY
  ANNUAL
}

enum NotificationType {
  LICENSE_EXPIRED
  LICENSE_EXPIRING_SOON
  NEW_USER
  USER_SUSPENDED
  USER_UPGRADED
}

enum ActivityType {
  ADMIN_LOGIN
  USER_SUSPENDED
  USER_REACTIVATED
  LICENSE_UPGRADED
  ADMIN_CREATED
  EMAIL_SENT
  PASSWORD_CHANGED
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
  THUMBS_UP
  THUMBS_DOWN
  FIRE
  HEART_EYES
  CLAP
  THINKING
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  phone                 String        @unique
  firstName             String
  lastName              String
  licenseKey            String        @unique
  licenseType           LicenseType   @default(FREE)
  licenseStatus         LicenseStatus @default(ACTIVE)
  subscriptionType      SubscriptionType? @default(MONTHLY) // MONTHLY ou ANNUAL
  activationDate        DateTime      @default(now())
  expirationDate        DateTime?
  isOnline              Boolean       @default(false)
  lastLoginAt           DateTime?
  activeSessionId       String?       @unique
  lastLoginIp           String?
  maxSimultaneousLogins Int           @default(1)
  expoPushToken         String?
  createdAt             DateTime      @default(now())

  license          License?              @relation("UserLicense")
  legalAcceptances UserLegalAcceptance[]
  notifications    Notification[]
  activityLogs     ActivityLog[]         @relation("ActivityTarget")
  devices          Device[]
  backups          UserBackup[]          @relation("UserBackups")
  payments         Payment[]             @relation("UserPayments")
  paymentTransactions PaymentTransaction[] @relation("UserPaymentTransactions")

  @@map("users")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())

  activityLogs ActivityLog[] @relation("ActivityAuthor")

  @@map("admins")
}

// Renommé "key" → "licenseKey" pour cohérence avec le reste du code
model License {
  id         String @id @default(uuid())
  email      String @unique
  licenseKey String @unique
  userId     String @unique
  user       User   @relation("UserLicense", fields: [userId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model ActivityLog {
  id          String       @id @default(uuid())
  type        ActivityType
  description String
  adminId     String
  admin       Admin        @relation("ActivityAuthor", fields: [adminId], references: [id], onDelete: Cascade)
  targetId    String?
  target      User?        @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)
  metadata    String?
  ipAddress   String?
  createdAt   DateTime     @default(now())

  @@map("activity_logs")
}

model Info {
  id            String     @id @default(uuid())
  title         String
  content       String
  imageUrl      String?
  imageFileId   String?
  imageFilePath String?
  thumbnailUrl  String?
  images        Json?      // Tableau d'images multiples [{url, fileId, filePath, thumbnailUrl}]
  published     Boolean    @default(true)
  publishedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reactions     Reaction[]

  @@map("infos")
}

model Reaction {
  id           String       @id @default(uuid())
  infoId       String
  info         Info         @relation(fields: [infoId], references: [id], onDelete: Cascade)
  reactionType ReactionType
  userId       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([infoId])
  @@index([ipAddress])
  @@map("reactions")
}

model AppDownload {
  id        String   @id @default(uuid())
  ipAddress String?
  userAgent String?
  source    String?
  createdAt DateTime @default(now())

  @@map("app_downloads")
}

model LegalDocument {
  id          String                @id @default(cuid())
  type        String
  version     String
  content     String                @db.Text
  publishedAt DateTime              @default(now())
  createdAt   DateTime              @default(now())
  acceptances UserLegalAcceptance[]

  @@map("legal_documents")
}

model UserLegalAcceptance {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id])
  acceptedAt DateTime      @default(now())

  @@unique([userId, documentId])
  @@map("user_legal_acceptances")
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   // UUID unique de l'appareil
  deviceName   String?  // Nom optionnel de l'appareil (ex: "iPhone 13", "Samsung S21")
  deviceType   String?  // Type: "ios" | "android"
  platform     String?  // Platforme: "ios" | "android" (stocké comme string)
  isAuthorized Boolean  @default(true) // Appareil autorisé
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("devices")
}

model UserBackup {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserBackups", fields: [userId], references: [id], onDelete: Cascade)
  fileName        String    // Nom du fichier (ex: "backup_2026-07-08.db")
  fileSize        Int       // Taille en bytes
  fileUrl         String?   // URL Supabase Storage (null si FREE et jamais accédé)
  uploadedAt      DateTime  @default(now())
  deviceId        String?   // Appareil d'origine du backup
  deviceName      String?   // Nom de l'appareil
  isAccessible    Boolean   @default(false) // true pour PREMIUM, false pour FREE
  accessGrantedAt DateTime? // Date d'accès accordé (si FREE upgrade vers PREMIUM)
  metadata        Json?     // Métadonnées additionnelles (version app, etc.)

  @@index([userId])
  @@index([uploadedAt])
  @@map("user_backups")
}

enum PaymentType {
  UPGRADE_PREMIUM
  RENEW_PREMIUM
  BACKUP_ACCESS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  amount        Int           // Montant en FCFA (999 ou 10000)
  currency      String        @default("XOF") // Franc CFA
  type          PaymentType   // Type de paiement
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique // ID transaction KKiaPay
  method        String?       // Méthode de paiement (wave, mtn, orange, moov, visa, mastercard)
  metadata      Json?         // Données additionnelles (backupId pour BACKUP_ACCESS, etc.)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?     // Date de confirmation du paiement

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentProvider {
  KKIAPAY
  MANUAL_ADMIN
}

model PaymentTransaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("UserPaymentTransactions", fields: [userId], references: [id], onDelete: Cascade)
  provider      PaymentProvider // KKIAPAY ou MANUAL_ADMIN
  transactionId String?         @unique // ID transaction KKiaPay (null si MANUAL_ADMIN)
  amount        Int             // Montant en FCFA
  status        PaymentStatus   // PENDING, SUCCESS, FAILED
  adminId       String?         // ID de l'admin qui a fait l'upgrade manuel (null si auto)
  subscriptionType SubscriptionType? // MONTHLY ou ANNUAL
  metadata      Json?           // Données additionnelles
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([userId])
  @@index([transactionId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}
